{
  "name": "allegro-api-library",
  "version": "1.0.2",
  "description": "Allegro marketplace REST API wrapper with OAuth2 support and sandbox environment",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "allegro",
    "allegro-api",
    "allegro-pl",
    "marketplace",
    "ecommerce",
    "api",
    "wrapper",
    "oauth2",
    "sdk"
  ],
  "author": "Selim Geçin",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "type": "module",
  "dependencies": {
    "axios": "^1.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.2",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-typescript": "^11.1.2",
    "@types/node": "^25.5.0",
    "@types/uuid": "^10.0.0",
    "rollup": "^3.26.2",
    "rollup-plugin-dts": "^6.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hopesf/allegro-api-library.git"
  },
  "bugs": {
    "url": "https://github.com/hopesf/allegro-api-library/issues"
  },
  "homepage": "https://github.com/hopesf/allegro-api-library#readme"
}
